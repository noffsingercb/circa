# Copy to .env for local development. Every value here is optional --
# src/lib/config.ts falls back to a sane default when the var is unset.

# --- API -------------------------------------------------------------------
# Base URL of the GeoHistory API service (server.ts, containerized on Render).
#
# Vite bakes this into the bundle at BUILD time, not at run time. A hosted
# deployment therefore has to set it in the host's build environment -- on
# Cloudflare Pages that is Settings > Environment variables -- and rebuild.
# Editing it afterwards changes nothing until the next build.
#
# IT NOW ALSO FEEDS THE CONTENT-SECURITY-POLICY. scripts/gen-headers.mjs reads
# this variable during `npm run build` and writes the API's origin into
# connect-src in build/_headers. That is deliberate: a CSP naming a different
# origin than the bundle calls blocks every request in the browser before it is
# sent, which looks exactly like an API outage. One variable, so they cannot
# disagree.
#
# If it is unset, the build still succeeds but warns loudly, and both the bundle
# and the CSP fall back to the same placeholder origin.
VITE_CIRCA_API=http://localhost:8787
VITE_CIRCA_TIMELINE_PATH=/v1/timeline
VITE_REQUEST_TIMEOUT_MS=15000

# --- Timeline shaping ------------------------------------------------------
VITE_LIFESPAN_CAP_YEARS=100
VITE_MAX_EVENTS=20
VITE_MAX_SEGMENTS=20

# The engine fills a segment by round-robin across five tiers (local,
# regional, national, global, person) whose quotas total 18, so this number
# decides which tiers get starved rather than trimming evenly. At 10 we took
# only 2 of the 4 available local rows and 2 of the 5 global. At 17: local 4,
# regional 3, national 4, global 4, person 2. See src/lib/config.ts.
#
# The API clamps this to 1-50 and MAX_SEGMENTS to 1-40; both current values sit
# well inside those bounds. GET /v1/meta publishes the full bounds table.
VITE_MAX_PER_SEGMENT=17

VITE_GLOBAL_CAP=80

# How far back a death-anchored final segment reaches. A death is an end date,
# so without this the last segment of a life has zero width and matches
# nothing. We cannot know when the person arrived, so this is an assumption.
VITE_DEATH_LOOKBACK_YEARS=8

# --- Relevance policy (see README > Tuning policy) -------------------------
# VITE_BASE_FLOOR and VITE_RELAXED_FLOOR are gone as of geohistory-core@0.5.1.
#
# The engine now keeps a separate floor per scope (local 0.05, regional 0.15,
# national 0.15, global 0.20). A single scalar sent as significanceFloor is
# applied as a blanket minimum to every scope not named explicitly, so the old
# VITE_BASE_FLOOR=0.15 was quietly lifting the local floor from 0.05 to 0.15
# and filtering out the curated local rows, which average 0.133. Circa now
# sends no floor at all on the base request and lets the engine's tuned
# defaults stand.

# Used only on the sparsity retry, and sent as scopeFloor.local rather than as
# a scalar -- a scalar would also lower the birth/death floor and flood a thin
# segment with minor local figures.
#
# The API clamps any floor to a minimum of 0.01, so this is comfortably inside
# the accepted range.
VITE_RELAXED_LOCAL_FLOOR=0.05

# Below this many entries, a segment is retried once with the floor above.
VITE_MIN_MATCHES=3

# --- Geocoder --------------------------------------------------------------
# Also written into connect-src by scripts/gen-headers.mjs. Pointing this at a
# different Photon instance means updating PHOTON_ORIGIN in that script too --
# it is hardcoded there because src/lib/config.ts hardcodes the same default.
VITE_PHOTON_HOST=photon.komoot.io
VITE_GEOCODE_DEBOUNCE_MS=300
VITE_GEOCODE_MIN_QUERY=3
VITE_GEOCODE_LIMIT=5

# --- Timeline rendering ----------------------------------------------------
VITE_PX_PER_YEAR=14
VITE_MIN_GAP_PX=96
